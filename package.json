{
  "name": "campus-carbon",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.json",
    "cf-typegen": "wrangler types",
    "seed:sql": "node seed/build-sql.ts > seed/seed.sql",
    "db:local": "wrangler d1 migrations apply campus-carbon --local && npm run seed:sql && wrangler d1 execute campus-carbon --local --file seed/seed.sql",
    "seed:routes": "node seed/fetch-routes.ts"
  },
  "dependencies": {
    "hono": "^4.13.10",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
